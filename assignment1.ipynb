        "\n",
        "paradox_matrix = (median_change > 0) & (poverty_change >= 0)\n",
        "\n",
        "period_names = [\"2019-2020\", \"2020-2022\", \"2022-2024\"]\n",
        "true_cells = []\n",
        "\n",
        "print(\"\\n=== Task 4.7: List Every True Cell (State & Period) ===\")\n",
        "for row_index in range(len(STATES)):\n",
        "    for col_index in range(len(period_names)):\n",
        "        if paradox_matrix[row_index, col_index]:\n",
        "            print(f\"- State: {STATES[row_index]} | Period: {period_names[col_index]}\")\n",
        "            true_cells.append((STATES[row_index], period_names[col_index]))"
