      "source": [
        "# TASK 5.1 — Build State Profile Function\n",
        "\n",
        "import numpy as np\n",
        "import json\n",
        "\n",
        "def build_state_profile(\n",
        "    state: str,\n",
        "    states: list[str],\n",
        "    years: list[int],\n",
        "    median: np.ndarray,\n",
        "    mean: np.ndarray,\n",
        "    poverty: np.ndarray,\n",
        "    poverty_years: list[int],\n",
        "    regions: dict[str, list[str]],\n",
        ") -> dict:\n",
        "    \"\"\"Return a JSON-serializable profile of one state without using global variables.\"\"\"\n",
        "    \n",
        "    # 1. Check if the state exists in the states list\n",
        "    if state not in states:\n",
        "        raise ValueError(f\"State '{state}' is not found in the states list!\")\n",
        "        \n",
        "    state_index = states.index(state)\n",
        "    \n",
        "    # 2. Identify the region for the state\n",
        "    found_region = \"\"\n",
        "    for region_name, state_list in regions.items():\n",
        "        if state in state_list:\n",
        "            found_region = region_name\n",
        "            break\n",
        "            \n",
        "    # 3. Calculate region mean for 2024 using a Boolean mask\n",
        "    region_states = regions.get(found_region, [])\n",
        "    region_mask = np.array([s in region_states for s in states])\n",
        "    region_mean_2024 = float(np.mean(median[region_mask, -1]))\n",
        "    state_median_2024 = float(median[state_index, -1])\n",
        "    \n",
        "    # 4. Calculate relative income index and rank for 2024\n",
        "    state_median_references = np.median(median, axis=0)\n",
        "    relative_indexes = median / state_median_references\n",
        "    state_relative_2024 = float(relative_indexes[state_index, -1])\n",
        "    \n",
        "    ranks = np.argsort(np.argsort(-median[:, -1])) + 1\n",
        "    state_rank_2024 = int(ranks[state_index])\n",
        "    \n",
        "    # 5. Calculate percentage growth from 2016 to 2024\n",
        "    start_value = median[state_index, 0]\n",
        "    end_value = median[state_index, -1]\n",
        "    growth_value = float(((end_value - start_value) / start_value) * 100)\n",
        "    \n",
        "    # 6. Build income history by year\n",
        "    income_history = []\n",
        "    for index in range(len(years)):\n",
        "        income_history.append({\n",
        "            \"year\": int(years[index]),\n",
        "            \"median\": float(median[state_index, index]) if not np.isnan(median[state_index, index]) else None,\n",
        "            \"mean\": float(mean[state_index, index]) if not np.isnan(mean[state_index, index]) else None\n",
        "        })\n",
        "        \n",
        "    # 7. Build poverty history by year\n",
        "    poverty_history = []\n",
        "    for index in range(len(poverty_years)):\n",
        "        poverty_history.append({\n",
        "            \"year\": int(poverty_years[index]),\n",
        "            \"poverty_absolute\": float(poverty[state_index, index]) if not np.isnan(poverty[state_index, index]) else None\n",
        "        })\n",
        "        \n",
        "    # 8. Evaluate paradox periods specific to this state\n",
        "    median_difference = np.column_stack([median[:, 2] - median[:, 1], median[:, 3] - median[:, 2], median[:, 4] - median[:, 3]])\n",
        "    poverty_difference = np.column_stack([poverty[:, 1] - poverty[:, 0], poverty[:, 2] - poverty[:, 1], poverty[:, 3] - poverty[:, 2]])\n",
        "    local_paradox_matrix = (median_difference > 0) & (poverty_difference >= 0)\n",
        "    local_period_names = [\"2019-2020\", \"2020-2022\", \"2022-2024\"]\n",
        "    \n",
        "    state_paradoxes = []\n",
        "    for col_index in range(len(local_period_names)):\n",
        "        if local_paradox_matrix[state_index, col_index]:\n",
        "            state_paradoxes.append(local_period_names[col_index])\n",
        "            \n",
        "    # 9. Combine all information into the final profile dictionary\n",
        "    profile = {\n",
        "        \"state\": state,\n",
        "        \"region\": found_region,\n",
        "        \"income_history\": income_history,\n",
        "        \"growth_2016_2024_pct\": growth_value,\n",
        "        \"relative_income_index_2024\": state_relative_2024,\n",
        "        \"rank_2024\": state_rank_2024,\n",
        "        \"region_mean_median_2024\": region_mean_2024,\n",
        "        \"is_above_region_mean\": state_median_2024 > region_mean_2024,\n",
        "        \"poverty_history\": poverty_history,\n",
        "        \"paradox_periods\": state_paradoxes\n",
        "    }\n",
        "    \n",
        "    return profile\n",
        "\n",
        "# Test the function specifically for W.P. Labuan and print JSON output\n",
        "test_profile = build_state_profile(\"W.P. Labuan\", STATES, SURVEY_YEARS, MEDIAN, MEAN, POVERTY, POVERTY_YEARS, REGIONS)\n",
        "\n",
        "print(\"\\n=== Task 5.1 Test Output (W.P. Labuan Profile) ===\")\n",
        "print(json.dumps(test_profile, indent=4))\n"
      ]
    }
