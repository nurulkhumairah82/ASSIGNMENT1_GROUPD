      "source": [
        "# TASK 4.6 — Regional Mean of Median Incomes\n",
        "\n",
        "import numpy as np\n",
        "import json\n",
        "\n",
        "# 1. Turn REGIONS into a state-to-region dictionary and raise exception if mismatch/overlap\n",
        "\n",
        "state_to_region = {}\n",
        "for region_name, state_list in REGIONS.items():\n",
        "    for state in state_list:\n",
        "        if state in state_to_region:\n",
        "            raise ValueError(f\"State '{state}' is assigned to multiple regions!\")\n",
        "        state_to_region[state] = region_name\n",
        "\n",
        "for state in STATES:\n",
        "    if state not in state_to_region:\n",
        "        raise ValueError(f\"State '{state}' does not belong to any region!\")\n",
        "\n",
        "if len(state_to_region) != len(STATES):\n",
        "    raise ValueError(\"The region mapping does not contain all states or has a mismatch!\")\n",
        "\n",
        "print(\"=== Task 4.6: Regional Means of Median Income ===\")\n",
        "region_means = {}\n",
        "\n",
        "# 2. Calculate unweighted mean for each region using a Boolean mask\n",
        "\n",
        "for region_name, state_list in REGIONS.items():\n",
        "    region_mask = np.array([state in state_list for state in STATES])\n",
        "    region_mean = np.mean(MEDIAN[region_mask, :], axis=0)\n",
        "    region_means[region_name] = region_mean\n",
        "    \n",
        "    print(f\"\\nRegion: {region_name}\")\n",
        "    for index, year in enumerate(SURVEY_YEARS):\n",
        "        print(f\"  Year {year}: RM {region_mean[index]:.2f}\")\n"
      ]
